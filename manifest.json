{
  "manifest_version": 3,
  "name": "Tab Sweeper",
  "version": "1.0.0",
  "description": "Warn about old tabs, auto-close distraction domains, and keep a saved tab list.",
  "permissions": ["tabs", "storage", "notifications", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tab Sweeper",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
